---
import Layout from '../layouts/Layout.astro';

const contacts = [
  { k: '24/7 EMERGENCY', v: '+1 281 690 0322', sub: 'Active well-control & blowout response' },
  { k: 'GENERAL ENQUIRIES', v: 'info@gunnarenergyservices.com', sub: 'Project scoping, partnerships, careers' },
  { k: 'HEADQUARTERS', v: 'Bakersfield, California', sub: '2202 Zeus Court, Bakersfield, CA 93308' },
];
const apps = ['Relief well', 'Plug & abandonment', 'CCUS', 'Geothermal', 'Solution mining', 'Well re-entry'];
const offices = [
  { city: 'Bakersfield, CA', tag: 'GLOBAL HEADQUARTERS', addr: '2202 Zeus Court, Bakersfield, California 93308' },
  { city: 'Los Angeles, CA', tag: 'CALIFORNIA OPERATIONS', addr: '750 N San Vicente Blvd, Suite 800, Los Angeles, California 90069' },
  { city: 'Houston, TX', tag: 'GULF COAST OPERATIONS', addr: '32003 Pattys Landing, Magnolia, Texas 77389' },
  { city: 'Calgary, AB', tag: 'CANADA OPERATIONS', addr: '700 2 St SW, Suite 1900, Calgary, Alberta T2P 2W2, Canada' },
  { city: 'South Perth, WA', tag: 'ASIA-PACIFIC', addr: '44A Onslow Street, South Perth WA 6151, Australia' },
];
---
<Layout title="Contact — Request a Feasibility Review | Gunnar Energy Services" description="Tell us about the well — geometry, access and timeline — and a ranging engineer will scope a deterministic intercept plan. 24/7 emergency well-control line available.">

  <!-- EMERGENCY STRIP -->
  <section style="background:var(--accent);color:var(--ground);padding:18px var(--pad);">
    <div style="max-width:1240px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;">
      <div style="display:flex;align-items:center;gap:12px;">
        <span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:var(--ground-2);"></span>
        <span style="font-family:'Archivo',sans-serif;font-weight:800;font-size:16px;letter-spacing:0.01em;">ACTIVE WELL-CONTROL EMERGENCY? CALL NOW — 24/7 RESPONSE.</span>
      </div>
      <a href="tel:+12816900322" style="background:var(--ground-2);color:var(--accent);font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:14px;padding:10px 18px;border-radius:0;">+1 281 690 0322 →</a>
    </div>
  </section>

  <section style="padding:72px var(--pad);background:var(--ground);color:var(--text);position:relative;overflow:hidden;">
    <div style="position:absolute;top:-160px;right:-120px;width:460px;height:460px;border-radius:50%;border:1px solid rgba(254,238,0,0.14);"></div>
    <div style="max-width:1240px;margin:0 auto;position:relative;display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start;">
      <div>
        <div style="font-family:'IBM Plex Mono',monospace;font-size:12.5px;letter-spacing:0.18em;color:var(--accent);margin-bottom:18px;">LET'S TALK</div>
        <h1 style="font-family:'Archivo',sans-serif;font-weight:900;font-size:clamp(30px,5vw,46px);line-height:1.02;letter-spacing:-0.025em;margin:0 0 22px;max-width:16ch;">Tell us about the well.</h1>
        <p style="font-size:18px;line-height:1.6;color:var(--text-dim);max-width:46ch;margin:0 0 36px;">Share the geometry, access and timeline, and a ranging engineer will scope a deterministic intercept plan. For active well-control emergencies, call the 24/7 line above.</p>
        <div style="display:grid;gap:22px;">
          {contacts.map((c) => (
            <div style="border-top:1px solid rgba(255,255,255,0.14);padding-top:16px;">
              <div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:0.14em;color:var(--text-faint);margin-bottom:6px;">{c.k}</div>
              <div style="font-size:16px;color:var(--text);font-weight:600;">{c.v}</div>
              <div style="font-size:13.5px;color:var(--text-faint);margin-top:2px;">{c.sub}</div>
            </div>
          ))}
        </div>
      </div>
      <div style="background:var(--surface);border:1px solid rgba(255,255,255,0.1);padding:34px;">
        <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.12em;color:var(--accent);margin-bottom:20px;">REQUEST A FEASIBILITY REVIEW</div>
        <form data-feasibility style="display:grid;gap:14px;">
          <div>
            <div style="font-size:12px;color:var(--text-faint);margin-bottom:6px;">Full name</div>
            <input class="gx-field" type="text" name="name" placeholder="Jane Engineer" aria-label="Full name" required />
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
            <div><div style="font-size:12px;color:var(--text-faint);margin-bottom:6px;">Company</div><input class="gx-field" type="text" name="company" placeholder="Operator Inc." aria-label="Company" /></div>
            <div><div style="font-size:12px;color:var(--text-faint);margin-bottom:6px;">Work email</div><input class="gx-field" type="email" name="email" placeholder="jane@operator.com" aria-label="Work email" required /></div>
          </div>
          <fieldset style="border:0;padding:0;margin:0;min-width:0;">
            <legend style="font-size:12px;color:var(--text-faint);margin-bottom:6px;padding:0;">Application</legend>
            <div style="display:flex;flex-wrap:wrap;gap:8px;">
              {apps.map((a) => (
                <label class="gx-chip-radio">
                  <input type="radio" name="application" value={a} />
                  <span style="display:inline-block;font-size:12px;font-family:'IBM Plex Mono',monospace;color:var(--text-dim);background:var(--ground-2);border:1px solid rgba(255,255,255,0.14);padding:7px 11px;border-radius:0;transition:all .12s ease;">{a}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <div>
            <div style="font-size:12px;color:var(--text-faint);margin-bottom:6px;">Well details &amp; timeline</div>
            <textarea class="gx-field" name="details" placeholder="Target depth, geometry, access constraints, timeline…" aria-label="Well details and timeline" style="height:90px;"></textarea>
          </div>
          <button class="gx-submit" type="submit">Submit request</button>
          <p data-form-status style="font-size:11.5px;color:var(--text-faint);margin:2px 0 0;text-align:center;line-height:1.5;">We typically respond within one business day. Emergencies: call the 24/7 line.</p>
        </form>
      </div>
    </div>
  </section>

  <section style="padding:64px var(--pad);background:var(--surface);border-bottom:1px solid var(--line);">
    <div style="max-width:1240px;margin:0 auto;">
      <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.2em;color:var(--accent);margin-bottom:22px;">OPERATING LOCATIONS</div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;">
        {offices.map((o) => (
          <div style="border:1px solid var(--line);padding:26px;">
            <div style="font-family:'Archivo',sans-serif;font-weight:700;font-size:19px;color:var(--text);margin-bottom:6px;">{o.city}</div>
            <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.06em;color:var(--accent);margin-bottom:12px;">{o.tag}</div>
            <p style="font-size:13.5px;color:var(--text-dim);line-height:1.55;margin:0;">{o.addr}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>

<script>
  import '../scripts/forms.js';
</script>
