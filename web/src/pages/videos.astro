---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/links.js';
import { videos, playlists, channelUrl } from '../data/videos.js';

const thumb = (id) => `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
const embed = (id) => `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
const fmt = (s) => { const m = Math.floor(s / 60); return m + ':' + String(s % 60).padStart(2, '0'); };
const featured = videos[0];
const rest = videos; // full library, newest-first (channel chronological order)
---
<Layout title="Video Library — Field Footage & Ranging Explainers | Gunnar Energy Services" description="Every video from the Gunnar Energy Services YouTube channel — field footage, magnetic-ranging explainers, case studies and engineer talks — playing right on the site, filterable by playlist.">

  <!-- HERO -->
  <section style="background:var(--ground);color:var(--text);position:relative;overflow:hidden;padding:60px var(--pad) 56px;">
    <div style="position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,0.045) 1px,transparent 1px);background-size:28px 28px;opacity:0.6;"></div>
    <div style="position:absolute;top:-180px;right:-140px;width:520px;height:520px;border-radius:50%;border:1px solid rgba(254,238,0,0.14);"></div>
    <div style="max-width:var(--maxw);margin:0 auto;position:relative;">
      <div style="font-family:var(--mono);font-size:11.5px;letter-spacing:0.08em;color:var(--text-faint);margin-bottom:22px;"><a href={url('/')} style="color:var(--text-faint);">Home</a> &nbsp;/&nbsp; <span style="color:var(--accent);">Videos</span></div>
      <div class="eyebrow" style="margin-bottom:16px;">Video Library</div>
      <h1 class="display d-l" style="max-width:18ch;">See the technology that hits the target.</h1>
      <p class="lede" style="max-width:62ch;margin-top:20px;">Field footage, plain-language explainers and conversations with the engineers who pioneered magnetic ranging — the full channel, playing right here.</p>
    </div>
  </section>

  <!-- FEATURED (latest) -->
  <section style="padding:0 var(--pad) 8px;background:var(--ground);">
    <div style="max-width:var(--maxw);margin:0 auto;">
      <div class="eyebrow eyebrow--dim" style="margin-bottom:16px;">Latest upload</div>
      <div data-video-frame style="position:relative;width:100%;aspect-ratio:16/9;max-height:62vh;background:var(--ground-2);overflow:hidden;border:1px solid var(--line);">
        <div data-video-facade role="button" tabindex="0" aria-label={`Play video: ${featured.title}`} data-embed={embed(featured.id)} data-title={featured.title} style={`position:absolute;inset:0;cursor:pointer;`}>
          <img src={thumb(featured.id)} alt="" loading="eager" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" />
          <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,12,15,0.15),rgba(10,12,15,0.72));"></div>
          <div style="position:absolute;left:clamp(20px,4vw,44px);bottom:32px;right:clamp(20px,4vw,44px);">
            <div class="display d-m" style="color:#fff;max-width:22ch;">{featured.title}</div>
          </div>
          <span class="v-play v-play--lg" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- LIBRARY: filter chips + chronological grid -->
  <section style="padding:40px var(--pad) 16px;background:var(--ground);">
    <div style="max-width:var(--maxw);margin:0 auto;">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:16px;margin-bottom:22px;">
        <h2 class="display d-m">The full library.</h2>
        <a href={channelUrl} target="_blank" rel="noopener" style="font-family:var(--mono);font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:var(--accent);">{videos.length} videos · browse on YouTube ↗</a>
      </div>

      <!-- playlist filters -->
      <div class="v-filters" role="group" aria-label="Filter videos by playlist">
        <button class="v-chip" data-filter="all" aria-pressed="true">All</button>
        {playlists.map((p) => (
          <button class="v-chip" data-filter={p.key} aria-pressed="false">{p.title}</button>
        ))}
      </div>

      <!-- grid (newest → oldest) -->
      <div class="v-grid">
        {rest.map((v) => (
          <article class="v-card" data-vid data-pls={v.pls.join(' ')}>
            <div data-video-frame class="v-frame">
              <div data-video-facade role="button" tabindex="0" aria-label={`Play video: ${v.title}`} data-embed={embed(v.id)} data-title={v.title} class="v-facade">
                <img src={thumb(v.id)} alt="" loading="lazy" decoding="async" class="v-thumb" />
                <span class="v-play" aria-hidden="true"></span>
                <span class="v-dur">{fmt(v.dur)}</span>
              </div>
            </div>
            <h3 class="v-title">{v.title}</h3>
          </article>
        ))}
      </div>
      <p class="v-empty" hidden>No videos in this playlist yet.</p>
    </div>
  </section>

  <!-- NEWSLETTER CTA -->
  <section style="padding:32px var(--pad) 80px;background:var(--ground);">
    <div style="max-width:var(--maxw);margin:0 auto;">
      <div style="border:1px solid var(--line);background:var(--surface);padding:32px 36px;display:flex;justify-content:space-between;align-items:center;gap:30px;flex-wrap:wrap;">
        <div>
          <div class="eyebrow" style="margin-bottom:10px;">Stay ahead of the well</div>
          <h2 class="h-card" style="font-size:22px;max-width:34ch;">New videos and technical guides — in your inbox.</h2>
        </div>
        <form data-feasibility style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-start;">
          <input class="gx-field" type="email" name="email" placeholder="your work email" aria-label="Work email" required style="min-width:240px;width:auto;" />
          <button class="gx-submit" type="submit" style="width:auto;padding:13px 22px;font-size:14px;">Subscribe</button>
          <p data-form-status style="font-size:11.5px;color:var(--text-faint);margin:0;width:100%;"></p>
        </form>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* filter chips — square, mono, hairline; active = electric yellow */
  .v-filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 26px; }
  .v-chip {
    font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--text-dim); background: var(--surface); border: 1px solid var(--line);
    padding: 9px 14px; cursor: pointer; border-radius: 0; transition: color .15s ease, border-color .15s ease, background .15s ease;
  }
  .v-chip:hover { color: var(--text); border-color: var(--line-strong); }
  .v-chip[aria-pressed="true"] { background: var(--accent); color: #0A0C0F; border-color: var(--accent); }

  .v-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 22px; }
  .v-card { display: flex; flex-direction: column; }
  .v-frame { position: relative; width: 100%; aspect-ratio: 16/9; background: var(--ground-2); overflow: hidden; border: 1px solid var(--line); transition: border-color .15s ease; }
  .v-card:hover .v-frame { border-color: var(--accent); }
  .v-facade { position: absolute; inset: 0; cursor: pointer; }
  .v-thumb { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.15) brightness(0.92); transition: filter .2s ease, transform .3s ease; }
  .v-card:hover .v-thumb { filter: none; transform: scale(1.03); }
  .v-dur { position: absolute; bottom: 8px; right: 8px; font-family: var(--mono); font-size: 11px; color: #fff; background: rgba(6,8,10,0.82); padding: 2px 6px; }
  .v-title { font-family: var(--display-n); font-weight: 700; font-size: 15px; line-height: 1.28; color: var(--text); margin: 12px 0 0; }
  /* play glyph — yellow disc + CSS triangle */
  .v-play { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 52px; height: 52px; border-radius: 50%; background: var(--accent); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 16px rgba(0,0,0,0.3); transition: transform .2s ease; }
  .v-card:hover .v-play { transform: translate(-50%, -50%) scale(1.08); }
  .v-play::after { content: ""; width: 0; height: 0; border-left: 16px solid #0A0C0F; border-top: 10px solid transparent; border-bottom: 10px solid transparent; margin-left: 4px; }
  .v-play--lg { width: 88px; height: 88px; }
  .v-play--lg::after { border-left-width: 27px; border-top-width: 16px; border-bottom-width: 16px; margin-left: 7px; }
  .v-empty { font-family: var(--mono); font-size: 13px; color: var(--text-faint); padding: 24px 0; }
  @media (max-width: 700px) { .v-grid { grid-template-columns: 1fr 1fr; gap: 14px; } .v-title { font-size: 13px; } }
  @media (max-width: 440px) { .v-grid { grid-template-columns: 1fr; } }
</style>

<script>
  import '../scripts/video-facade.js';
  import '../scripts/forms.js';

  // Playlist filtering — purely show/hide; videos stay in chronological order.
  const chips = [...document.querySelectorAll('.v-chip')];
  const cards = [...document.querySelectorAll('.v-card')];
  const empty = document.querySelector('.v-empty');
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const k = chip.dataset.filter;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      let shown = 0;
      cards.forEach((card) => {
        const match = k === 'all' || card.dataset.pls.split(' ').includes(k);
        card.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown !== 0;
    });
  });
</script>
